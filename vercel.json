{
  "version": 2,
  "builds": [
    {
      "src": "package.json",
      "use": "@vercel/static-build",
      "config": { "distDir": "build" }
    }
  ],
  "routes": [
    { "handle": "filesystem" },
    { "src": "/api/(.*)", "dest": "https://studynotion-backend-g7ip.onrender.com/api/v1/$1" },
    { "src": "/.*", "dest": "/index.html" }
  ]
}
